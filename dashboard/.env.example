## Copy this file to `dashboard/.env` and edit the values, or set these as environment variables.

# API server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8001
DASHBOARD_API_KEY=dev-token
ENABLE_PUBLIC_DASHBOARD=0
# Public tunnel provider: cloudflare or ngrok (default in run_all.py is cloudflare)
PUBLIC_TUNNEL_PROVIDER=cloudflare
# Optional: full path to cloudflared binary if not in PATH
CLOUDFLARED_BIN=
# Optional: ngrok auth token for higher limits/stability
NGROK_AUTHTOKEN=

# Serial bridge (RS485 / COM)
SERIAL_PORT=COM3
BAUDRATE=9600

# Telegram bot
TELEGRAM_TOKEN="Your Telegram Bot Token"
ADMIN_CHAT="Your Chat ID"

# Misc
# If you want serial_reader and bot to post/read to/from this address override it here
# Example: http://127.0.0.1:8000
DASHBOARD_API_URL=http://127.0.0.1:8001/api/readings

SERIAL_PORT=/dev/ttyAMA0
BAUDRATE=9600
MODBUS_SLAVE_ID=1
MODBUS_FUNCTION=3
MODBUS_MAP=humidity:10:10,temperature:11:10,ec:12:1,ph:13:10,np_n:14:1,np_p:19:1,np_k:6:1
# Optional: run one-time register scan to discover addresses (set SERIAL_MODE=modbus_probe)
#SERIAL_MODE=modbus_probe
#MODBUS_PROBE_START=0
#MODBUS_PROBE_END=30
#MODBUS_PROBE_FUNCTIONS=3,4
SERIAL_POLL_INTERVAL=5
SIMULATE_SENSOR=0